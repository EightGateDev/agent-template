#!/bin/bash
# {{AGENT_NAME}} — Claude Code self-healing session
# Auto-restarts with --channels so Telegram plugin stays connected.

SESSION="{{AGENT_NAME}}"
AGENT_DIR="/opt/{{AGENT_NAME}}"
export PATH="$HOME/.bun/bin:$PATH"

# Source agent env so the Telegram plugin extension gets
# DASHBOARD_WEBHOOK_URL, DASHBOARD_AGENT_TOKEN, AGENT_ID, MEMEPALACE_URL
[[ -f "$AGENT_DIR/.env" ]] && set -a && source "$AGENT_DIR/.env" && set +a

mkdir -p "$AGENT_DIR/logs"

if [ -n "$TMUX" ]; then
  cd "$AGENT_DIR"

  # Start local MemPalace HTTP server (port 7766) if not already running
  if ! curl -s http://localhost:7766/health >/dev/null 2>&1; then
    nohup "$AGENT_DIR/.venv/bin/python3" "$AGENT_DIR/mempalace_server.py" \
      >> "$AGENT_DIR/logs/mempalace.log" 2>&1 &
    echo "[$(date)] MemPalace server started"
  fi

  # ── Vikunja task manager (dev agents only, port 3456) ─────────────────────
  if [ "${VIKUNJA_ENABLED:-false}" = "true" ]; then
    VIKUNJA_BIN="$AGENT_DIR/bin/vikunja"
    mkdir -p "$AGENT_DIR/bin" "$AGENT_DIR/vikunja-data"
    # Download binary on first run (Vikunja ships as -full.zip, not bare binary)
    if [ ! -f "$VIKUNJA_BIN" ]; then
      echo "[$(date)] Downloading Vikunja..."
      _VK_URL=$(curl -s https://api.github.com/repos/go-vikunja/vikunja/releases/latest \
        | grep -oE '"browser_download_url": *"[^"]*linux-amd64-full\.zip"' \
        | grep -oE 'https[^"]+' | head -1)
      if [ -n "$_VK_URL" ]; then
        _VK_TMP=$(mktemp -d)
        curl -fsSL "$_VK_URL" -o "$_VK_TMP/vk.zip" \
          && (cd "$_VK_TMP" && unzip -oq vk.zip) \
          && _VK_BIN=$(find "$_VK_TMP" -maxdepth 2 -type f ! -iname '*.zip' \
               -printf '%s\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2-) \
          && mv "$_VK_BIN" "$VIKUNJA_BIN" && chmod +x "$VIKUNJA_BIN" \
          && echo "[$(date)] Vikunja downloaded"
        rm -rf "$_VK_TMP"
      else
        echo "[$(date)] Vikunja download URL not found — skipping"
      fi
    fi
    # Start if binary exists and Vikunja not yet running
    if [ -f "$VIKUNJA_BIN" ] && ! curl -s http://localhost:3456/api/v1/info >/dev/null 2>&1; then
      VIKUNJA_SERVICE_PUBLICURL=http://localhost:3456 \
      VIKUNJA_DATABASE_PATH="$AGENT_DIR/vikunja-data/vikunja.db" \
      VIKUNJA_SERVICE_SECRET="${VIKUNJA_JWTSECRET:-vikunja_$(hostname)_secret}" \
      VIKUNJA_SERVICE_ENABLEREGISTRATION=true \
      VIKUNJA_LOG_LEVEL=WARNING \
      nohup "$VIKUNJA_BIN" >> "$AGENT_DIR/logs/vikunja.log" 2>&1 &
      sleep 3
      echo "[$(date)] Vikunja started on localhost:3456"
    fi
    # First-time init (idempotent — exits immediately if already configured)
    AGENT_DIR="$AGENT_DIR" python3 "$AGENT_DIR/skills/vikunja/setup_vikunja.py" 2>/dev/null || true
  fi

  # Ensure Claude auth credentials exist in agent's HOME-isolated dir
  mkdir -p "$AGENT_DIR/.claude"
  [[ ! -f "$AGENT_DIR/.claude/.credentials.json" ]] && \
    cp /home/claudebot/.claude/.credentials.json "$AGENT_DIR/.claude/.credentials.json" 2>/dev/null && \
    chmod 600 "$AGENT_DIR/.claude/.credentials.json" || true

  # Instagram channel flag — added only when INSTAGRAM_ENABLED=true
  IG_FLAGS=""
  if [ "${INSTAGRAM_ENABLED:-false}" = "true" ]; then
    IG_FLAGS="--dangerously-load-development-channels plugin:instagram-dm@local"
  fi

  while true; do
    # Kill orphaned plugin bun processes (Telegram + Instagram channel) from previous crashes.
    # Without this, each crash leaves ~115MB bun process alive; after a few
    # restarts the VPS OOM-kills Claude before it can fully start.
    pkill -9 -f "bun server.ts" 2>/dev/null || true
    pkill -9 -f "skills/instagram/channel" 2>/dev/null || true
    sleep 1

    # ── Telegram plugin preflight (race-proof) ────────────────────────────────
    # Claude caches installed-plugin state ONCE at startup. If the plugin isn't registered
    # yet when this session launches, the --channels Telegram bridge never loads and the bot
    # stays silent until a restart. ENSURE it via Claude's own CLI here — idempotent and
    # version-agnostic — BEFORE the patch + launch. A fast no-op once already registered.
    _CB="$HOME/.bun/bin/claude"
    if ! HOME="$AGENT_DIR" "$_CB" plugin list 2>/dev/null | grep -q "telegram@claude-plugins-official"; then
      echo "[$(date)] [plugin-preflight] telegram plugin not registered — installing via CLI" >> "$AGENT_DIR/logs/prompt_watcher.log"
      HOME="$AGENT_DIR" "$_CB" plugin marketplace add anthropics/claude-plugins-official >> "$AGENT_DIR/logs/prompt_watcher.log" 2>&1 || true
      HOME="$AGENT_DIR" "$_CB" plugin install telegram@claude-plugins-official    >> "$AGENT_DIR/logs/prompt_watcher.log" 2>&1 || true
    fi

    # HOME override isolates this agent's Claude state under $AGENT_DIR/.claude/
    # so access.json, messages.db, settings, and plugin cache are per-agent.
    # ~/.bun/bin expands using the shell's original HOME (/home/claudebot), not $AGENT_DIR.
    HOME="$AGENT_DIR" python3 "$AGENT_DIR/patches/telegram_plugin.py" 2>/dev/null || true

    # Inline prompt acceptor — background job that watches this session's pane.
    # Must use explicit -t "$SESSION" — without it, tmux commands from a background
    # subshell (no attached client) target nothing and return empty.
    # Runs up to 90 s (30 × 3 s) — fresh installs can take 60+ s to show the dialog.
    # Searches full pane (no tail/head) — dialog renders at TOP of terminal, not bottom.
    # Unique text per dialog avoids false matches:
    #   Trust dialog:  "Yes, I trust this folder" → Enter (select option 1)
    #   Bypass dialog: "Yes, I accept"            → Down+Enter (select option 2)
    (
      LOGF="$AGENT_DIR/logs/prompt_watcher.log"
      for _i in $(seq 1 30); do
        sleep 3
        BOT=$(tmux capture-pane -t "$SESSION" -p 2>/dev/null || echo "")  # full pane — dialog can be at top or bottom
        if echo "$BOT" | grep -q "trust this folder"; then
          echo "[$(date)] auto-accepted folder trust" >> "$LOGF"
          tmux send-keys -t "$SESSION" Enter; sleep 1
        fi
        if echo "$BOT" | grep -q "Yes, I accept"; then
          echo "[$(date)] auto-accepted bypass permissions" >> "$LOGF"
          tmux send-keys -t "$SESSION" Down; sleep 0.5
          tmux send-keys -t "$SESSION" Enter; break
        fi
        if echo "$BOT" | grep -qE "match terminal|Dark mode|Light mode|choose a theme|To change this later"; then
          echo "[$(date)] auto-accepted theme picker" >> "$LOGF"
          tmux send-keys -t "$SESSION" Enter; sleep 1
        fi
        if echo "$BOT" | grep -qE "Resume from summary|Resuming the full session|Don't ask me again"; then
          echo "[$(date)] auto-selected dont-ask-again for resume dialog" >> "$LOGF"
          tmux send-keys -t "$SESSION" Down; sleep 0.2
          tmux send-keys -t "$SESSION" Down; sleep 0.2
          tmux send-keys -t "$SESSION" Enter; sleep 1
        fi
        if echo "$BOT" | grep -qE "Reconnect|✘ failed.*MCP|Plugin.*failed|↑.*↓.*navigate"; then
          echo "[$(date)] auto-reconnecting failed MCP plugin" >> "$LOGF"
          tmux send-keys -t "$SESSION" "1" Enter; sleep 2
        fi
        if echo "$BOT" | grep -q "bypass permissions on"; then break; fi
      done
    ) &

    # Plugin guard — if Claude boots but the Telegram plugin never spawns (flaky first-boot
    # MCP connect: claude alive but bot silent), kill Claude so the loop relaunches with a
    # fresh channel. pkill is user-scoped → only this agent's Claude. Grace period first.
    (
      sleep 120
      for _g in $(seq 1 20); do
        tmux has-session -t "$SESSION" 2>/dev/null || break
        if ! pgrep -f "$AGENT_DIR/.claude/plugins/cache/claude-plugins-official/telegram" >/dev/null 2>&1; then
          echo "[$(date)] [plugin-guard] Telegram plugin not running — restarting Claude" >> "$AGENT_DIR/logs/prompt_watcher.log"
          pkill -f "dangerously-skip-permissions" 2>/dev/null
          break
        fi
        sleep 30
      done
    ) &

    # Use --continue only when a prior session exists in this HOME-isolated dir.
    # On a fresh install there's nothing to continue — Claude exits with
    # "No conversation found" and loops forever if --continue is always passed.
    CONTINUE_FLAG=""
    if find "$AGENT_DIR/.claude/projects" -name "*.jsonl" 2>/dev/null | grep -q .; then
      CONTINUE_FLAG="--continue"
    fi

    HOME="$AGENT_DIR" ~/.bun/bin/claude \
      --dangerously-skip-permissions \
      $CONTINUE_FLAG \
      --channels plugin:telegram@claude-plugins-official \
      $IG_FLAGS

    echo "[$(date)] claude exited — restarting in 5s..."
    sleep 5
  done
else
  tmux kill-session -t "$SESSION" 2>/dev/null
  sleep 1
  tmux new-session -d -s "$SESSION" -x 220 -y 50 "bash $AGENT_DIR/start.sh"
  echo "Agent $SESSION started. Attach: tmux attach -t $SESSION"
fi
