# ── Основні (обов'язкові) ──────────────────────────────────────────────────
AGENT_NAME=my-agent                    # slug агента (директорія /opt/my-agent)
AGENT_TIMEZONE=Europe/Kyiv             # часовий пояс

TELEGRAM_BOT_TOKEN=                    # токен від @BotFather
TELEGRAM_OWNER_ID=                     # твій Telegram user ID (@userinfobot)
TELEGRAM_ALLOWED_CHATS=                # додаткові chat_id через кому (опційно)

# Claude Code OAuth токен — запустити: claude setup-token (потрібна підписка Claude Pro/Max)
CLAUDE_CODE_OAUTH_TOKEN=

# ── Пам'ять ───────────────────────────────────────────────────────────────
MEMEPALACE_URL=http://localhost:7766   # локальний MemPalace (не змінювати)

# ── Google-скіли (Calendar, Gmail, Docs, Sheets) ──────────────────────────
# Інструкція зі створення клієнта: skills/google_calendar/SETUP.md
GOG_KEYRING_PASSWORD=                  # пароль для зберігання Google OAuth токенів

# ── Голос ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=                          # groq.com — розпізнавання голосу (Whisper)
ELEVENLABS_API_KEY=                    # elevenlabs.io — синтез мовлення
ELEVENLABS_VOICE_ID=                   # ID голосу в ElevenLabs

# ── Пошук ─────────────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=                    # perplexity.ai — пошук в інтернеті

# ── Дзвінки ───────────────────────────────────────────────────────────────
VAPI_API_KEY=                          # vapi.ai — голосові дзвінки

# ── NanoBan (перевірка компаній) ──────────────────────────────────────────
NANOBAN_API_KEY=                       # nanoban.com.ua — опційно
